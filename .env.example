# Copy to .env and fill in real values. Never commit .env.

# Google Maps JavaScript API key used by google-maps-config.js / google-maps-live.js
# Restrict this key in Google Cloud Console to your site's domains, and enable
# only Maps JavaScript API + Places API. See google-maps-live.js for the
# in-app "Google Maps settings" admin flow, which stores a key in the
# visitor's browser localStorage as an alternative to hardcoding one here.
GOOGLE_MAPS_API_KEY=

# ABA PayWay credentials (see ABA-PAYWAY-INTEGRATION.md).
# These are required by a future secure server component, NOT by this
# static frontend. Never expose PAYWAY_API_KEY or PAYWAY_RSA_PUBLIC_KEY
# in browser JavaScript.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_RSA_PUBLIC_KEY=
PAYWAY_BASE_URL=
PAYWAY_CALLBACK_URL=https://your-domain.com/api/payments/payway/callback
PAYWAY_RETURN_URL=https://your-domain.com/billing/payment-result
